APP_ENV=development

API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_USER=trader
POSTGRES_PASSWORD=traderpass
POSTGRES_DB=tradingbot

# Database URL for async pg (asyncpg dialect is required)
DATABASE_URL=postgresql+asyncpg://trader:traderpass@localhost:5432/tradingbot

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

LOG_LEVEL=INFO

PAPER_TRADING=true
APP_NAME=Trading Bot API
APP_VERSION=1.0.0
DEBUG=True

# Fyers API Configuration
FYERS_APP_ID=your_fyers_app_id
FYERS_SECRET_KEY=your_fyers_secret_key
FYERS_REDIRECT_URI=http://localhost:8000/api/v1/broker/fyers/callback
